[Unit]
Description=Mount boot partition

[Mount]
# The kernel assigns mmcblk numbers in MMC host registration order,
# which can flip between boots; never reference the boot partition by
# device number. The vfat label "boot" is set by mkfs.fat -n boot in
# the image build and is stable across image builds (unlike the FAT
# UUID or the MBR disk signature).
What=/dev/disk/by-label/boot
Where=/boot
Options=ro

[Install]
WantedBy=multi-user.target
