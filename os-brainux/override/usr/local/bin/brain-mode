#!/bin/sh
# brain-mode — user-customizable usage profiles.
#
# What this device should be is the user's call, not ours: a mode is
# just a small key=value profile, and anyone can add their own.
#
#   /usr/share/brain-modes/<id>.conf   factory profiles (examples)
#   /etc/brain-modes/<id>.conf         user profiles (win over factory)
#
# Fields (one per line, KEY=value, quotes optional):
#   NAME          display name
#   DESC          one-line description
#   GADGET        brain-gadget profile: net | deck | share | off
#   SERVICES      space-separated systemd units started while active
#   LAUNCH        app the settings page offers to open (optional)
#   LAUNCH_LABEL  label for that button (optional)
#
#   brain-mode get          print the active profile id
#   brain-mode list         id|name|desc|launch|launch_label per line
#   brain-mode set <id>     persist and apply a profile now
#   brain-mode apply        apply the persisted profile (boot)
#
# State: /etc/brain-mode (active id). Default: normal.

STATE=/etc/brain-mode
RUNDIR_SVC=/run/brain-mode.services
FACTORY=/usr/share/brain-modes
USERDIR=/etc/brain-modes

profile_path() {
    if [ -f "$USERDIR/$1.conf" ]; then echo "$USERDIR/$1.conf";
    elif [ -f "$FACTORY/$1.conf" ]; then echo "$FACTORY/$1.conf";
    else return 1; fi
}

field() { # file key -> value (unquoted)
    sed -n "s/^$2=//p" "$1" | head -1 | sed 's/^"//; s/"$//'
}

list_ids() {
    { ls "$FACTORY" 2>/dev/null; ls "$USERDIR" 2>/dev/null; } \
        | sed -n 's/\.conf$//p' | sort -u
}

mode_get() {
    if [ -f "$STATE" ]; then cat "$STATE"; else echo normal; fi
}

mode_apply() {
    id=$(mode_get)
    p=$(profile_path "$id") || { echo "brain-mode: no profile '$id'" >&2; return 1; }
    gadget=$(field "$p" GADGET); gadget=${gadget:-off}
    services=$(field "$p" SERVICES)

    # stop the previous profile's units
    if [ -f "$RUNDIR_SVC" ]; then
        for u in $(cat "$RUNDIR_SVC"); do systemctl stop "$u" 2>/dev/null; done
        rm -f "$RUNDIR_SVC"
    fi
    brain-gadget "$gadget" || return 1
    if [ -n "$services" ]; then
        for u in $services; do systemctl start "$u" 2>/dev/null; done
        echo "$services" > "$RUNDIR_SVC"
    fi
    return 0
}

case "$1" in
    get) mode_get ;;
    list)
        for id in $(list_ids); do
            p=$(profile_path "$id")
            echo "$id|$(field "$p" NAME)|$(field "$p" DESC)|$(field "$p" LAUNCH)|$(field "$p" LAUNCH_LABEL)"
        done
        ;;
    apply) mode_apply ;;
    set)
        if ! profile_path "$2" >/dev/null; then
            echo "brain-mode: unknown profile '$2'" >&2
            echo "available: $(list_ids | tr '\n' ' ')" >&2
            exit 2
        fi
        echo "$2" > "$STATE"
        mode_apply
        echo "mode: $2"
        ;;
    *)
        echo "usage: brain-mode {get|list|set <id>|apply}" >&2; exit 2 ;;
esac
