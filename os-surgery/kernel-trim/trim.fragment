# Brainux OS surgery — kernel config trim, tier 1 (2026-11-21)
# Applied on top of the actually-built config (dtb-out/.config,
# brain_defconfig lineage). Rationale per item: REPORT-os-surgery-1.md
# sections 1.2 / 1.3. Rule: no hardware on PW-SH6 (per DTS), not
# needed at boot, no user-visible function removed. NFS is only
# demoted to a module (function preserved, RAM freed).

# MTD stack: no NAND/NOR on the board (GPMI pins are GPIO hogs,
# boot and rootfs are MMC only). Cascades: CFI, DATAFLASH, SST25L,
# RAW_NAND, GPMI_NAND, SPI_NOR, UBI.
# CONFIG_MTD is not set

# MTD filesystems: cannot mount without MTD devices.
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set

# SGTL5000 is the i.MX28 EVK codec; the Brain codec is BU26154.
# CONFIG_SND_SOC_MXS_SGTL5000 is not set
# CONFIG_SND_SOC_SGTL5000 is not set

# i.MX28 Ethernet: ENET pins are GPIO hogs, no PHY, DT nodes off.
# CONFIG_FEC is not set

# DRM drivers with no DT node on any Brain model handled here:
# USB DisplayLink and a 4.3" Seiko panel (EVK hardware).
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_PANEL_SEIKO_43WVF1G is not set

# NFS client: not used at boot (rootfs is local ext4, fstab
# unconfigured). Demote to modules; SUNRPC/LOCKD follow.
CONFIG_NFS_FS=m
